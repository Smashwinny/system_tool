[Unit]
Description=Repair monitor layout once at login or on real DRM hotplug
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStart=%h/.local/share/system-tool/monitor_hotplug.py
Restart=on-failure
RestartSec=5s
CPUQuota=2%
MemoryMax=32M

[Install]
WantedBy=default.target
