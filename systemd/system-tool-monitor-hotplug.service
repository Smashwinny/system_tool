[Unit]
Description=Maintain monitor layout from DRM and X11 RandR change events
After=graphical-session.target

[Service]
Type=simple
Environment=DISPLAY=:1
ExecStart=%h/.local/share/system-tool/monitor_hotplug.py
Restart=on-failure
RestartSec=5s
CPUQuota=2%
MemoryMax=32M

[Install]
WantedBy=default.target
